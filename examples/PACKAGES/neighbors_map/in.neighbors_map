dimension       3
boundary        p p p
units           metal
atom_style      atomic
#read_data       Cu_noisy.lmp
read_data       Cu_perfect.lmp  

pair_style      zero 8.0
pair_coeff      * *  
#pair_coeff * *  eam/alloy Cu_mishin1.eam.alloy Cu
  
# pair_style      hybrid/overlay zero 8.0 eam/alloy
# pair_coeff * *  zero
# pair_coeff * *  eam/alloy Cu_mishin1.eam.alloy Cu

timestep        0.001

thermo          50
thermo_style    custom step pe ke temp

compute         nm all neighborsmap/atom 8.0 32 1.0 1.0

dump            d1 all custom 50 test_nm.dump id x y z c_nm[*]
  
fix             1 all nve

run             0
